<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
		<!-- VSIX-SdkProjectAdapter's README says it sets this by default, but in practice
         it still warns without it being set explicitly here - without it, the tasks
         that actually build the .vsix container and deploy it never run. -->
		<VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Deploys the built VSIX into the experimental hive so F5 actually installs it,
         instead of just starting a plain devenv.exe that knows nothing about it. Only a Debug
         build made by Visual Studio deploys: 'dotnet build' cannot (the VSSDK targets fail it
         with "VSIX deployment is not supported"), and it still has to build the whole solution. -->
		<DeployExtension>false</DeployExtension>
		<DeployExtension Condition="'$(Configuration)' == 'Debug' And '$(BuildingInsideVisualStudio)' == 'true'">true</DeployExtension>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Launches the experimental instance on F5. -->
		<StartAction>Program</StartAction>
		<StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
		<StartArguments>/rootSuffix Exp /log</StartArguments>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.SDK" />
		<PackageReference Include="Microsoft.VSSDK.BuildTools" />
		<PackageReference Include="VSIX-SdkProjectAdapter" />
		<!-- Compile-time only, as in Core: the attributes newer C# features need (records, init) that
         .NET Framework 4.8 lacks. Nothing of it is shipped. -->
		<PackageReference Include="PolySharp" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- WPF's controls, from the .NET Framework itself (nothing is shipped in the .vsix): the
         translation section of a tooltip that is filled in when its translation arrives is a
         WPF element. The Visual Studio packages bring WPF's core assemblies, not this one. -->
		<Reference Include="PresentationFramework" />
		<!-- The classic settings page is a Windows Forms property grid underneath. -->
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup>
		<!-- The translator window's menu items and shortcut, compiled into the resource the package names in
         ProvideMenuResource. -->
		<VSCTCompile Include="TranslatorWindow\Commands.vsct">
			<ResourceName>Menus.ctmenu</ResourceName>
		</VSCTCompile>
	</ItemGroup>

	<ItemGroup>
		<!-- Assemblies the Visual Studio packages bring along that Visual Studio itself already has (17.14 and
         later): two copies of an assembly Visual Studio loads invite type-identity trouble. Only whole
         assemblies are named here: a file of an assembly the extension needs, such as Core's symbols, takes
         the assembly itself out with it. -->
		<SuppressFromVsix Include="Microsoft.VisualStudio.Extensibility.Editor.Contracts.dll" />
		<SuppressFromVsix Include="Microsoft.VisualStudio.Linux.ConnectionManager.Store.dll" />
		<SuppressFromVsix Include="System.Text.Encodings.Web.dll" />
	</ItemGroup>

	<ItemGroup>
		<!-- The settings Visual Studio 2026 shows in Tools > Options, read by Visual Studio from the .vsix. -->
		<Content Include="Options\registration.json">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Contracts and the pure pipe-naming logic shared with the Engine. This is the
         only cross-project reference allowed here: net48 cannot reference a
         net10.0-windows assembly (Engine) under any circumstances, not even with
         ReferenceOutputAssembly="false" - MSBuild rejects the reference itself before
         it even gets to deciding what to link. The Vsix only ever talks to the Engine
         as a separate process, over the named pipe (see Service/ServiceLauncher.cs and
         Service/ServiceClient.cs). Visual Studio's own "Build Solution" step on F5
         builds every project in the solution, Engine included, so its output is already
         on disk by the time ServiceLauncher looks for it - no project-to-project
         reference is needed for that ordering either. -->
		<ProjectReference Include="..\VisualStudioTranslator.Core\VisualStudioTranslator.Core.csproj" />
	</ItemGroup>

	
	<PropertyGroup>
		<!-- Whether the .vsix carries the Engine. A Release build does: that is the one handed to users. A Debug
         build runs the Engine project's own output instead (below), which keeps F5 quick. Either can be
         overridden with -p:PackEngine=true or false. -->
		<PackEngine Condition="'$(PackEngine)' == '' And '$(Configuration)' == 'Release'">true</PackEngine>
		<PackEngine Condition="'$(PackEngine)' == ''">false</PackEngine>
		<EngineProject>$(MSBuildThisFileDirectory)..\VisualStudioTranslator.Engine\VisualStudioTranslator.Engine.csproj</EngineProject>
		<!-- Absolute: the publish runs in the Engine's project, where a relative path would mean its own folder. -->
		<EnginePublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'EnginePublish', '$(Configuration)'))</EnginePublishDir>
		<!-- Self-contained: the Engine brings its own .NET runtime, so it runs where .NET 10 is not installed, as
         with Visual Studio 2022. Not trimmed: StreamJsonRpc and Newtonsoft.Json find members by reflection,
         which trimming can silently break. -->
		<EnginePublishProperties>Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(EnginePublishDir)</EnginePublishProperties>
	</PropertyGroup>

	<ItemGroup Condition="'$(PackEngine)' != 'true'">
		<!-- For a build without the Engine: the absolute path of the Engine project's output, written into the
         assembly while $(MSBuildThisFileDirectory) is still the real path on disk, since this DLL later runs
         from the experimental instance's extension folder. Left out of a packed build, which would otherwise
         carry the developer's own folders to every user. -->
		<AssemblyMetadata Include="DevelopmentEnginePath" Value="$(MSBuildThisFileDirectory)..\VisualStudioTranslator.Engine\bin\$(Configuration)\net10.0-windows\VisualStudioTranslator.Engine.exe" />
	</ItemGroup>

	<!-- Publishes the Engine and puts it in the .vsix under Engine\, where ServiceLauncher looks for it. The
	     restore comes first, on its own, because a self-contained publish needs the runtime for win-x64,
	     which the solution's ordinary restore does not fetch. The solution builds the Engine before this
	     project (BuildDependency in the .slnx), so the restore never runs alongside the Engine's own build.
	     Symbols are left out of the package. -->
	<Target Name="PackEngineIntoVsix" BeforeTargets="GetVsixSourceItems" Condition="'$(PackEngine)' == 'true'">
		<RemoveDir Directories="$(EnginePublishDir)" />
		<MSBuild Projects="$(EngineProject)" Targets="Restore" Properties="$(EnginePublishProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
		<MSBuild Projects="$(EngineProject)" Targets="Publish" Properties="$(EnginePublishProperties)" />
		<ItemGroup>
			<EnginePublishedFile Include="$(EnginePublishDir)**\*" Exclude="$(EnginePublishDir)**\*.pdb" />
			<VSIXSourceItem Include="@(EnginePublishedFile)">
				<VSIXSubPath>Engine\%(EnginePublishedFile.RecursiveDir)</VSIXSubPath>
			</VSIXSourceItem>
		</ItemGroup>
	</Target>

	<!-- Lets source.extension.vsixmanifest read a build-time version, like a NuGet package would. -->
	<Target Name="GetVersion" Returns="$(Version)" />

</Project>