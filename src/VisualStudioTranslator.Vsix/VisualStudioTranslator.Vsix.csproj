<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!-- VSIX-SdkProjectAdapter's README says it sets this by default, but in practice
         it still warns without it being set explicitly here — without it, the tasks
         that actually build the .vsix container and deploy it never run. -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Deploys the built VSIX into the experimental hive so F5 actually installs it,
         instead of just starting a plain devenv.exe that knows nothing about it. -->
    <DeployExtension>true</DeployExtension>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Launches the experimental instance on F5. -->
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootSuffix Exp /log</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" />
    <!-- Wires Microsoft.VSSDK.BuildTools correctly into an SDK-style project: brings in
         the real packaging/deploy targets (tools\vssdk\Microsoft.VsSDK.targets), which
         NuGet does not auto-import on its own, without the target-graph conflicts a bare
         manual <Import> of that file caused (it broke the base "Build" target). -->
    <PackageReference Include="VSIX-SdkProjectAdapter" />
  </ItemGroup>

  <!-- Lets source.extension.vsixmanifest read a build-time version, like a NuGet package would. -->
  <Target Name="GetVersion" Returns="$(Version)" />

</Project>